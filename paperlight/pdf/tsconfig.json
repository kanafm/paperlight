{
	"compilerOptions": {
		"target": "ES2024",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"skipLibCheck": true,
		"lib": ["ES2024", "DOM", "DOM.Iterable"],
		"types": ["node", "vscode"]
	},
	"include": ["src/**/*.ts", "test/**/*.ts"]
}
